{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "utbh://schemas/test-def.schema.json",
  "title": "UTBH Test Definition",
  "description": "Data-driven test package (*.utbh parsed into utbh_core::TestDef). MUST stay in sync with utbh-core types (AGENTS.md aturan #8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["test", "input", "operation", "validation", "benchmark"],
  "properties": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "description"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements", "type", "seed"],
      "properties": {
        "elements": { "type": "integer" },
        "type": { "type": "string", "enum": ["f32", "u64", "i64"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tolerance"],
      "properties": {
        "mode": { "type": "string", "enum": ["exact", "approx", "none"] },
        "tolerance": { "type": ["number", "null"] }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "iterations"],
      "properties": {
        "metrics": { "type": "array", "items": { "type": "string" } },
        "iterations": { "type": "integer" }
      }
    }
  }
}